{% extends 'base.html.twig' %}

{% block body %}
    <div style="text-align: center;">
        <a href="{{ path('product_index') }}">← Retour à la liste</a>
        
        <h1>{{ product.title }}</h1>
        <img src="{{ product.image }}" alt="{{ product.title }}" style="width: 200px; height: 200px; object-fit: contain;">
        <p>{{ product.description }}</p>
        <p><strong>Prix : {{ product.price }} €</strong></p>

        <hr>

        <h2>Commentaires</h2>
 
        <div style="max-width: 400px; margin: auto;">
            {{ form_start(commentForm) }}
                {{ form_row(commentForm.content, {
                    'attr': {
                        'style': 'width: 100%; min-height: 100px; padding: 10px;',
                        'placeholder': 'Écrivez votre commentaire ici...'
                    },
                    'label': 'Votre commentaire'
                }) }}
                <button type="submit" class="btn-submit">Ajouter un commentaire</button>
            {{ form_end(commentForm) }}
        </div>

        <div>
            {% for comment in comments %}
                <div>
                    <p>{{ comment.content }} <small>({{ comment.createdAt|date('Y-m-d H:i') }})</small></p>
                    <a href="{{ path('comment_edit', {id: comment.id}) }}">Modifier</a>

                    <form action="{{ path('comment_delete', {id: comment.id}) }}" method="post" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                        <button style="color:red; background:none; border:none; cursor:pointer;">Supprimer</button>
                    </form>
                </div>
            {% else %}
                <p>Aucun commentaire pour le moment.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
